# ── Node / Express ───────────────────────
PORT=5000

# ── PostgreSQL ────────────────────────────
DB_USER=postgres
DB_HOST=localhost
DB_NAME=shopxp
DB_PASSWORD=your_db_password_here
DB_PORT=5432

# ── JWT ──────────────────────────────────
# Generate a strong random secret, e.g: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# ── Python Flask microservice URL ────────
FLASK_URL=http://localhost:8000
FLASK_PORT=8000
CLEANED_CSV=cleaned_transactions.csv

# ── Contact form email (optional) ────────
# Leave blank to only save messages to DB without sending email
# To enable email: set to your Gmail address and a Gmail App Password
# (Google Account → Security → 2-Step Verification → App passwords)
CONTACT_EMAIL=
EMAIL_APP_PASSWORD=
